# Required - from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional but strongly recommended - pixel-level SynthID check for ChatGPT images
OPENAI_API_KEY=

# Optional - AI-image classifier for images with no watermark/metadata
# (Midjourney, Flux, Grok, screenshots...). Keys from sightengine.com dashboard.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Score 0-1 the classifier must reach to count as AI. Higher = fewer false alarms.
SIGHTENGINE_THRESHOLD=0.90
# review = react ⚠️ and post to the log channel; delete = remove like a watermark hit
CLASSIFIER_ACTION=review

# Check local metadata from Stable Diffusion tools, Midjourney, IPTC tags, etc.
METADATA_CHECK=true

# React ✅ on images that pass every check
REACT_CLEAN=true

# ===================== Logging =====================
# Where removals, ⚠️ reviews and restores are recorded. Two places:
#
# 1. A Discord channel for mods (with Restore buttons).
#    Easiest: run /ai-log-channel #channel in your server (overrides this line).
#    Or put the channel ID here as the default for every server:
LOG_CHANNEL_ID=
#
# 2. A log file on the Zima box (one line per event, rotated at 5 MB, keeps 5 old files).
#    Default: data/removals.log  ->  /DATA/AppData/discord-ai-image-block/data/removals.log
#    To put it somewhere else, use a path under /app/data/, or under /app/logs/ and
#    uncomment the logs line in docker-compose.yml. Leave blank to turn the file off.
REMOVAL_LOG_FILE=/app/data/removals.log
# ===================================================

# Optional - comma-separated role IDs that are never scanned (e.g. mods)
EXEMPT_ROLE_IDS=

# Optional - only scan these channel IDs (blank = whole server)
WATCH_CHANNEL_IDS=

# Post a short auto-deleting notice to the user when their image is removed
NOTIFY_USER=true

# true = react 🤖 instead of deleting (testing)
DRY_RUN=false

# --- Custom removal messages (optional) ---
# Each kind of catch has its own message. Uncomment to change one.
# {user} = the poster's mention, {detail} = tool name / signer / classifier score
# MSG_GEMINI={user} your image was removed — it was made with **Google Gemini**.
# MSG_CHATGPT={user} your image was removed — it was made with **ChatGPT**.
# MSG_SYNTHID={user} your image was removed — it carries a **SynthID** AI watermark.
# MSG_C2PA={user} your image was removed — its Content Credentials say it's AI-generated (signed by {detail}).
# MSG_STABLE_DIFFUSION={user} your image was removed — it has Stable Diffusion settings saved in it ({detail}).
# MSG_GENERATOR={user} your image was removed — its metadata says it was made with **{detail}**.
# MSG_IPTC={user} your image was removed — its metadata is tagged as AI-generated.
# MSG_CLASSIFIER={user} your image was removed — our detector is {detail} sure it's AI-generated.
# Added to the end of every message (set to blank to remove):
# MSG_FOOTER= AI images aren't allowed here.

# How many days removed posts are kept so a mod can restore them
QUARANTINE_DAYS=30


# How often one person can use /ai-check (seconds) - protects your API quotas
CHECK_COOLDOWN_SECONDS=30

# Check DIRECT image links (e.g. https://i.imgur.com/abc.png). News articles,
# social posts and other page previews are never checked.
# Downloaded through Discord's own media proxy, never from the linked site.
SCAN_LINKS=true
# Also check Tenor/Giphy reaction GIFs (off by default - they use API quota)
SCAN_GIF_LINKS=false

# Largest file to check, in MB (Discord Nitro allows uploads up to 500 MB).
# Images over 45 MB are shrunk just for the online checks; local checks see the original.
MAX_FILE_MB=500
